{
  "name": "@deepseek-ai/dsh-runtime-launcher",
  "description": "Profile-booting stdio entry point for Agent Runtime’s Python SDK runtime",
  "version": "0.1.2-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    }
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Proprietary",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "bin": {
    "dsh-jsonrpc-agent": "lib/startup.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-sdk-app": "workspace:^",
    "@deepseek-ai/dsh-agent-runtime": "workspace:^",
    "@deepseek-ai/dsh-fs-broker": "workspace:^",
    "@deepseek-ai/dsh-subprocess-broker": "workspace:^",
    "@deepseek-ai/dsh-runtime-broker": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^"
  }
}
